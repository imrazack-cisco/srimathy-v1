"use client";

import { useEffect, useRef, useState } from "react";

interface VoiceWorkspaceProps {
  grade?: string;
  subject?: string;
  board?: string;
  book?: string;
}

type VoiceStatus =
  | "idle"
  | "listening"
  | "processing"
  | "speaking"
  | "error";

interface VoiceMetrics {
  speechRecognitionMs: number;
  aiLatencyMs: number;
  ttsLatencyMs: number;
  totalLatencyMs: number;
  confidence: number;
}

interface VoiceSample {
  totalLatencyMs: number;
  speechRecognitionMs: number;
  aiLatencyMs: number;
  ttsLatencyMs: number;
  confidence: number;
  timestamp?: number;
}

export default function VoiceWorkspace({
  grade = "5",
  subject = "Mathematics",
  board = "NCERT",
  book = "Math Mela",
}: VoiceWorkspaceProps) {

  const recognitionRef = useRef<any>(null);

  const recognitionStartRef =
    useRef<number>(0);

  const endToEndStartRef =
    useRef<number>(0);

  const [status, setStatus] =
    useState<VoiceStatus>("idle");

  const [transcript, setTranscript] =
    useState("");

  const [answer, setAnswer] =
    useState("");

  const [error, setError] =
    useState("");

  const [supported, setSupported] =
    useState(true);

  const [provider, setProvider] =
    useState("Detecting...");

  const [model, setModel] =
    useState("Detecting...");

  const [ttsProvider, setTtsProvider] =
    useState("macOS SpeechSynthesis");

  const [metrics, setMetrics] =
    useState<VoiceMetrics>({
      speechRecognitionMs: 0,
      aiLatencyMs: 0,
      ttsLatencyMs: 0,
      totalLatencyMs: 0,
      confidence: 0,
    });

  /*
   * Keep every completed voice interaction.
   * This is what allows us to calculate real P50/P95.
   */
  const [samples, setSamples] =
    useState<VoiceSample[]>([]);

  /*
   * Number of successful completed
   * voice interactions.
   */
  const [successfulSamples, setSuccessfulSamples] =
    useState(0);

  /*
   * Number of attempted voice interactions.
   */
  const [attemptedSamples, setAttemptedSamples] =
    useState(0);

  useEffect(() => {

    if (
      typeof window === "undefined"
    ) {
      return;
    }

    const SpeechRecognition =
      (window as any).SpeechRecognition ||
      (window as any).webkitSpeechRecognition;

    if (!SpeechRecognition) {

      setSupported(false);

      setError(
        "Speech recognition is not available in this browser. Please use Chrome on your Mac."
      );

      return;
    }

    const recognition =
      new SpeechRecognition();

    recognition.lang =
      "en-IN";

    recognition.continuous =
      false;

    recognition.interimResults =
      true;

    recognition.maxAlternatives =
      1;

    recognition.onstart = () => {

      const now =
        performance.now();

      recognitionStartRef.current =
        now;

      /*
       * IMPORTANT:
       *
       * This is the true beginning of the
       * end-to-end voice pipeline.
       */
      endToEndStartRef.current =
        now;

      setStatus("listening");

      setError("");

      setTranscript("");

      setAnswer("");

      setAttemptedSamples(
        previous =>
          previous + 1
      );
    };

    recognition.onresult =
      (event: any) => {

        let finalText = "";

        let interimText = "";

        let confidence = 0;

        for (
          let i = event.resultIndex;
          i < event.results.length;
          i++
        ) {

          const result =
            event.results[i];

          const text =
            result[0]?.transcript ?? "";

          if (
            result.isFinal
          ) {

            finalText += text;

            confidence =
              result[0]?.confidence ?? 0;

          } else {

            interimText += text;

          }

        }

        setTranscript(
          finalText ||
          interimText
        );

        if (
          finalText.trim()
        ) {

          handleQuestion(
            finalText.trim(),
            confidence
          );
        }
      };

    recognition.onerror =
      (event: any) => {

        console.error(
          "Speech recognition error:",
          event
        );

        setStatus("error");

        if (
          event.error ===
          "not-allowed"
        ) {

          setError(
            "Microphone permission was denied. Allow microphone access for localhost."
          );

        } else if (
          event.error ===
          "no-speech"
        ) {

          setError(
            "I didn't hear anything. Please try again."
          );

        } else {

          setError(
            `Voice recognition error: ${event.error}`
          );

        }

      };

    recognition.onend =
      () => {

        setStatus(
          previous =>
            previous === "listening"
              ? "idle"
              : previous
        );

      };

    recognitionRef.current =
      recognition;

    return () => {

      try {

        recognition.stop();

      } catch {}

    };

  }, []);

  async function startListening() {

    if (
      !recognitionRef.current
    ) {

      setError(
        "Speech recognition is not available."
      );

      return;
    }

    try {

      window.speechSynthesis?.cancel();

      setError("");

      setTranscript("");

      setAnswer("");

      recognitionRef.current.start();

    } catch (error) {

      console.error(error);

      setError(
        "Could not start the microphone. Please try again."
      );

    }

  }

  function stopListening() {

    try {

      recognitionRef.current?.stop();

    } catch {}

  }

  async function handleQuestion(
    question: string,
    confidence: number
  ) {

    const speechRecognitionMs =
      Math.round(
        performance.now() -
        recognitionStartRef.current
      );

    setStatus("processing");

    try {

      const response =
        await fetch(
          "/api/voice",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json",
            },

            body:
              JSON.stringify({
                question,
                grade,
                subject,
                board,
                book,
              }),
          }
        );

      const data =
        await response.json();

      if (!response.ok) {

        throw new Error(
          data?.error ||
          "Voice request failed."
        );

      }

      const aiLatencyMs =
        Number(
          data.aiLatencyMs || 0
        );

      setAnswer(
        data.answer || ""
      );

      setProvider(
        data.provider ||
        "Ollama Local"
      );

      setModel(
        data.model ||
        "gemma3:4b"
      );

      setMetrics(
        previous => ({
          ...previous,

          speechRecognitionMs,

          aiLatencyMs,

          confidence,
        })
      );

      if (
        data.answer
      ) {

        await speakAnswer(
          data.answer,
          speechRecognitionMs,
          aiLatencyMs,
          confidence
        );

      } else {

        setStatus("idle");

      }

    } catch (error: any) {

      console.error(
        "Voice request failed:",
        error
      );

      setStatus("error");

      setError(
        error?.message ||
        "Unable to process your question."
      );

    }

  }

  /*
   * Browser/macOS TTS.
   *
   * We deliberately measure until utterance.onend,
   * not merely until speechSynthesis.speak() is called.
   *
   * This gives us real Text → Voice completion time.
   */
  function speakAnswer(
    text: string,
    speechRecognitionMs: number,
    aiLatencyMs: number,
    confidence: number
  ): Promise<void> {

    return new Promise(
      resolve => {

        const ttsStart =
          performance.now();

        setStatus("speaking");

        if (
          typeof window ===
            "undefined" ||
          !window.speechSynthesis
        ) {

          const ttsLatencyMs = 0;

          const totalLatencyMs =
            Math.round(
              performance.now() -
              endToEndStartRef.current
            );

          recordSample({
            totalLatencyMs,
            speechRecognitionMs,
            aiLatencyMs,
            ttsLatencyMs,
            confidence,
          });

          setMetrics({
            speechRecognitionMs,
            aiLatencyMs,
            ttsLatencyMs,
            totalLatencyMs,
            confidence,
          });

          setTtsProvider(
            "Unavailable"
          );

          setStatus("idle");

          resolve();

          return;
        }

        window.speechSynthesis.cancel();

        const utterance =
          new SpeechSynthesisUtterance(
            text
          );

        utterance.lang =
          "en-IN";

        utterance.rate =
          0.92;

        utterance.pitch =
          1.0;

        utterance.volume =
          1.0;

        const voices =
          window.speechSynthesis.getVoices();

        const IndianVoice =
          voices.find(
            voice =>
              voice.lang
                ?.toLowerCase()
                .includes("en-in")
          );

        if (
          IndianVoice
        ) {

          utterance.voice =
            IndianVoice;

        }

        let completed =
          false;

        const finish =
          () => {

            if (
              completed
            ) {

              return;

            }

            completed =
              true;

            const ttsLatencyMs =
              Math.round(
                performance.now() -
                ttsStart
              );

            /*
             * TRUE end-to-end latency:
             *
             * microphone start
             * → STT
             * → Ollama
             * → TTS finished
             */
            const totalLatencyMs =
              Math.round(
                performance.now() -
                endToEndStartRef.current
              );

            setMetrics({
              speechRecognitionMs,
              aiLatencyMs,
              ttsLatencyMs,
              totalLatencyMs,
              confidence,
            });

            setTtsProvider(
              "macOS SpeechSynthesis"
            );

            recordSample({
              totalLatencyMs,
              speechRecognitionMs,
              aiLatencyMs,
              ttsLatencyMs,
              confidence,
            });

            setStatus("idle");

            resolve();

          };

        utterance.onend =
          finish;

        utterance.onerror =
          finish;

        window.speechSynthesis.speak(
          utterance
        );

      }
    );

  }

  function recordSample(
    sample: VoiceSample
  ) {

    setSamples(
      previous => {

        /*
         * Keep the latest 100 samples.
         * Enough for a meaningful local
         * performance demonstration.
         */
        const updated =
          [
            ...previous,
            {
              ...sample,
              timestamp:
                Date.now(),
            },
          ].slice(-100);

        return updated;

      }
    );

    setSuccessfulSamples(
      previous =>
        previous + 1
    );

  }

  function percentile(
    values: number[],
    percentileValue: number
  ): number {

    if (
      values.length === 0
    ) {

      return 0;

    }

    const sorted =
      [...values].sort(
        (a, b) => a - b
      );

    const index =
      Math.ceil(
        percentileValue /
          100 *
          sorted.length
      ) - 1;

    return (
      sorted[
        Math.max(
          0,
          Math.min(
            index,
            sorted.length - 1
          )
        )
      ] || 0
    );

  }

  const latencyValues =
    samples.map(
      sample =>
        sample.totalLatencyMs
    );

  const p50 =
    percentile(
      latencyValues,
      50
    );

  const p95 =
    percentile(
      latencyValues,
      95
    );

  const maximum =
    latencyValues.length
      ? Math.max(
          ...latencyValues
        )
      : 0;

  const successRate =
    attemptedSamples > 0
      ? Math.round(
          (
            successfulSamples /
            attemptedSamples
          ) * 100
        )
      : 0;

  const p95Pass =
    samples.length > 0 &&
    p95 <= 2500;

  const latestPass =
    metrics.totalLatencyMs > 0 &&
    metrics.totalLatencyMs <= 2500;

  if (!supported) {

    return (
      <div className="rounded-3xl border border-red-500/30 bg-red-950/20 p-8">

        <h2 className="text-2xl font-bold text-red-300">
          🎙 Voice unavailable
        </h2>

        <p className="mt-3 text-slate-300">
          {error}
        </p>

        <p className="mt-4 text-sm text-slate-500">
          Recommended: Chrome on macOS with
          microphone permission enabled.
        </p>

      </div>
    );

  }

  return (
    <section className="w-full space-y-6">

      {/* HEADER */}

      <div className="rounded-3xl border border-cyan-500/20 bg-slate-950/70 p-6">

        <div className="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">

          <div>

            <div className="text-sm font-semibold uppercase tracking-widest text-cyan-400">
              SRIMATHY VOICE LAB
            </div>

            <h2 className="mt-2 text-3xl font-bold text-white">
              Talk to your AI Teacher
            </h2>

            <p className="mt-2 text-slate-400">
              Ask your question naturally.
              SRIMATHY listens, reasons and
              speaks the answer back.
            </p>

          </div>

          <div className="rounded-2xl border border-cyan-500/20 bg-cyan-500/5 px-5 py-4 text-sm">

            <div className="text-slate-500">
              Curriculum
            </div>

            <div className="mt-1 font-semibold text-white">
              Grade {grade} · {subject}
            </div>

            <div className="text-xs text-slate-500">
              {board} · {book}
            </div>

          </div>

        </div>

      </div>


      {/* MAIN VOICE CONTROL */}

      <div className="rounded-3xl border border-slate-700 bg-slate-900/70 p-8">

        <div className="flex flex-col items-center">

          <button
            type="button"
            onClick={
              status === "listening"
                ? stopListening
                : startListening
            }
            disabled={
              status === "processing" ||
              status === "speaking"
            }
            className={`
              flex h-32 w-32
              items-center justify-center
              rounded-full
              text-5xl
              shadow-2xl
              transition-all
              duration-300
              ${
                status === "listening"
                  ? "scale-110 bg-red-500 shadow-red-500/30"
                  : status === "processing"
                  ? "bg-yellow-500 shadow-yellow-500/20"
                  : status === "speaking"
                  ? "bg-purple-500 shadow-purple-500/30"
                  : "bg-cyan-500 shadow-cyan-500/30 hover:scale-105"
              }
            `}
          >

            {status === "listening"
              ? "⏹"
              : status === "processing"
              ? "🧠"
              : status === "speaking"
              ? "🔊"
              : "🎙"}

          </button>

          <div className="mt-5 text-lg font-semibold text-white">

            {status === "listening"
              ? "Listening…"
              : status === "processing"
              ? "Thinking…"
              : status === "speaking"
              ? "Speaking…"
              : "Tap to speak"}

          </div>

          <div className="mt-2 text-sm text-slate-500">

            {status === "listening"
              ? "Ask your mathematics question"
              : "Mac microphone → SRIMATHY → AI voice"}

          </div>

        </div>


        {/* TRANSCRIPT */}

        {transcript && (

          <div className="mt-8 rounded-2xl border border-slate-700 bg-slate-950 p-5">

            <div className="text-xs font-semibold uppercase tracking-wider text-cyan-400">
              Student
            </div>

            <div className="mt-3 text-lg text-white">
              “{transcript}”
            </div>

          </div>

        )}


        {/* ANSWER */}

        {answer && (

          <div className="mt-4 rounded-2xl border border-purple-500/20 bg-purple-500/5 p-5">

            <div className="text-xs font-semibold uppercase tracking-wider text-purple-400">
              SRIMATHY
            </div>

            <div className="mt-3 whitespace-pre-wrap text-lg leading-relaxed text-white">
              {answer}
            </div>

          </div>

        )}


        {/* ERROR */}

        {error && (

          <div className="mt-4 rounded-xl border border-red-500/30 bg-red-950/30 p-4 text-sm text-red-300">
            {error}
          </div>

        )}

      </div>


      {/* RUNTIME */}

      <div className="grid grid-cols-1 gap-4 md:grid-cols-3">

        <RuntimeCard
          title="AI Provider"
          value={provider}
          subtitle={model}
        />

        <RuntimeCard
          title="TTS Engine"
          value={ttsProvider}
          subtitle="macOS native speech"
        />

        <RuntimeCard
          title="Speech Confidence"
          value={`${Math.round(
            metrics.confidence * 100
          )}%`}
          subtitle="Recognition confidence"
        />

      </div>


      {/* PERFORMANCE */}

      <div className="rounded-3xl border border-slate-700 bg-slate-950/70 p-6">

        <div className="mb-5 flex items-center justify-between">

          <div>

            <div className="text-xs font-semibold uppercase tracking-widest text-slate-500">
              VOICE TELEMETRY
            </div>

            <h3 className="mt-1 text-xl font-bold text-white">
              End-to-End Performance
            </h3>

          </div>

          <div className={`rounded-full px-3 py-1 text-xs font-semibold ${
            latestPass
              ? "bg-emerald-500/10 text-emerald-400"
              : "bg-amber-500/10 text-amber-400"
          }`}>
            {latestPass
              ? "UNDER 2.5s"
              : "LIVE"}
          </div>

        </div>


        <div className="grid grid-cols-2 gap-4 md:grid-cols-4">

          <Metric
            label="Speech → Text"
            value={`${metrics.speechRecognitionMs} ms`}
          />

          <Metric
            label="AI Response"
            value={`${metrics.aiLatencyMs} ms`}
          />

          <Metric
            label="Text → Voice"
            value={`${metrics.ttsLatencyMs} ms`}
          />

          <Metric
            label="Total"
            value={`${metrics.totalLatencyMs} ms`}
          />

        </div>

      </div>


      {/* PROFESSOR PERFORMANCE TEST */}

      <div className="rounded-3xl border border-cyan-500/20 bg-slate-950/80 p-6">

        <div className="flex items-center justify-between">

          <div>

            <div className="text-xs font-semibold uppercase tracking-widest text-cyan-400">
              REAL-TIME VOICE BENCHMARK
            </div>

            <h3 className="mt-1 text-xl font-bold text-white">
              Speech-to-Speech Stress Test
            </h3>

            <p className="mt-2 text-sm text-slate-500">
              Target: P95 end-to-end latency under 2.5 seconds
            </p>

          </div>

          <div
            className={`rounded-full px-4 py-2 text-sm font-bold ${
              p95Pass
                ? "bg-emerald-500/10 text-emerald-400"
                : samples.length === 0
                ? "bg-slate-800 text-slate-400"
                : "bg-red-500/10 text-red-400"
            }`}
          >
            {samples.length === 0
              ? "NO SAMPLES"
              : p95Pass
              ? "✓ P95 PASS"
              : "✕ P95 > 2.5s"}
          </div>

        </div>


        <div className="mt-6 grid grid-cols-2 gap-4 md:grid-cols-5">

          <BenchmarkCard
            label="Samples"
            value={String(samples.length)}
          />

          <BenchmarkCard
            label="P50"
            value={`${p50} ms`}
          />

          <BenchmarkCard
            label="P95"
            value={`${p95} ms`}
          />

          <BenchmarkCard
            label="Maximum"
            value={`${maximum} ms`}
          />

          <BenchmarkCard
            label="Success"
            value={`${successRate}%`}
          />

        </div>


        <div className="mt-5 rounded-2xl border border-slate-800 bg-slate-900/60 p-4">

          <div className="flex items-center justify-between">

            <div>

              <div className="text-sm font-semibold text-white">
                End-to-End Requirement
              </div>

              <div className="mt-1 text-xs text-slate-500">
                Speech → SLM → Voice
              </div>

            </div>

            <div className="text-right">

              <div className={`text-lg font-bold ${
                p95Pass
                  ? "text-emerald-400"
                  : samples.length === 0
                  ? "text-slate-400"
                  : "text-red-400"
              }`}>
                P95 ≤ 2500 ms
              </div>

              <div className="text-xs text-slate-500">
                {samples.length === 0
                  ? "Start speaking to collect samples"
                  : p95Pass
                  ? "Requirement satisfied"
                  : "Continue testing / optimize latency"}
              </div>

            </div>

          </div>

        </div>

      </div>


      {/* ARCHITECTURE */}

      <div className="rounded-3xl border border-slate-800 bg-slate-950/50 p-6">

        <div className="text-xs font-semibold uppercase tracking-widest text-slate-600">
          VOICE PIPELINE
        </div>

        <div className="mt-5 grid grid-cols-1 gap-3 md:grid-cols-7">

          <Pipeline
            icon="🎙"
            title="Mac Mic"
            text="Speech"
          />

          <Arrow />

          <Pipeline
            icon="📝"
            title="STT"
            text="Transcript"
          />

          <Arrow />

          <Pipeline
            icon="🧠"
            title="SRIMATHY"
            text={`${provider} / ${model}`}
          />

          <Arrow />

          <Pipeline
            icon="🔊"
            title="macOS TTS"
            text="Spoken answer"
          />

        </div>

      </div>

    </section>
  );
}


/* ============================================================
   UI COMPONENTS
   ============================================================ */

function RuntimeCard({
  title,
  value,
  subtitle,
}: {
  title: string;
  value: string;
  subtitle: string;
}) {

  return (

    <div className="rounded-3xl border border-slate-800 bg-slate-950/80 p-6">

      <div className="text-xs uppercase tracking-wider text-slate-500">
        {title}
      </div>

      <div className="mt-3 text-xl font-bold text-white">
        {value}
      </div>

      <div className="mt-1 text-sm text-slate-500">
        {subtitle}
      </div>

    </div>

  );
}


function Metric({
  label,
  value,
}: {
  label: string;
  value: string;
}) {

  return (

    <div className="rounded-2xl bg-slate-900 p-4">

      <div className="text-sm text-slate-500">
        {label}
      </div>

      <div className="mt-2 text-2xl font-bold text-cyan-400">
        {value}
      </div>

    </div>

  );
}


function BenchmarkCard({
  label,
  value,
}: {
  label: string;
  value: string;
}) {

  return (

    <div className="rounded-2xl border border-slate-800 bg-slate-900/80 p-4">

      <div className="text-xs uppercase tracking-wider text-slate-500">
        {label}
      </div>

      <div className="mt-2 text-xl font-bold text-white">
        {value}
      </div>

    </div>

  );
}


function Pipeline({
  icon,
  title,
  text,
}: {
  icon: string;
  title: string;
  text: string;
}) {

  return (

    <div className="rounded-2xl border border-slate-800 bg-slate-900 p-4 text-center">

      <div className="text-2xl">
        {icon}
      </div>

      <div className="mt-2 text-sm font-semibold text-white">
        {title}
      </div>

      <div className="mt-1 text-xs text-slate-500">
        {text}
      </div>

    </div>

  );
}


function Arrow() {

  return (

    <div className="flex items-center justify-center text-slate-600">

      <span className="hidden md:block text-xl">
        →
      </span>

      <span className="md:hidden text-xl">
        ↓
      </span>

    </div>

  );

}
